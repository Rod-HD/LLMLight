# ============================================================================
# LLMLight Reproduction - Environment Variables Template
# ============================================================================
# Copy this file to `.env` and fill in your actual values.
# `.env` is gitignored — never commit your real keys.
# ============================================================================

# ----------------------------------------------------------------------------
# LLM API Backends (priority: OPENAI > GROQ > PUTER)
# ----------------------------------------------------------------------------

# Puter.js — Free demo backend (≤100 requests/run, GPT-4o)
# Get token from: https://puter.com/account → "Auth Token" → Copy
# Token format: long JWT starting with "eyJhbGc..."
PUTER_AUTH_TOKEN=

# Groq — Free OpenAI-compatible backend (~14k req/day, Llama-3.3-70B)
# Get key from: https://console.groq.com/keys → Create API Key
# Key format: starts with "gsk_..."
GROQ_API_KEY=

# OpenAI — Paid backend for full-scale runs (GPT-4o, no rate limit)
# Get key from: https://platform.openai.com/api-keys
# Key format: starts with "sk-..."
# Leave empty unless running paid full simulation.
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# HuggingFace
# ----------------------------------------------------------------------------

# HF token — needed to download LightGPT models (even though MIT-licensed,
# rate limits are stricter for anonymous downloads).
# Get from: https://huggingface.co/settings/tokens → New fine-grained token
# Token format: starts with "hf_..."
HF_TOKEN=

# ----------------------------------------------------------------------------
# Project Paths (WSL2 mount paths)
# ----------------------------------------------------------------------------

# Root of the project, mounted from Windows D: drive into WSL2.
PROJECT_DIR=/mnt/d/path/to/LLMLight

# HuggingFace model cache directory (large — keep on D: drive).
HF_HOME=/mnt/d/path/to/LLMLight/models/hf_cache

# Path to the cloned LLMTSCS repo (contains datasets and finetune scripts).
LLMTSCS_DIR=/mnt/d/path/to/LLMLight/LLMTSCS

# ----------------------------------------------------------------------------
# Run Mode
# ----------------------------------------------------------------------------

# "demo" → 250 timesteps, fits in Puter 100-request budget for testing.
# "full" → 3600 timesteps, requires Groq or OpenAI backend.
# CLI flag --mode overrides this.
DEFAULT_RUN_MODE=demo

# Random seed for reproducibility (NumPy, PyTorch, CityFlow init).
RANDOM_SEED=42
